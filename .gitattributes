# Normalise text files to LF in the repository.
* text=auto

# Shell scripts must check out with LF on every platform, or they fail on
# Linux with a bad-interpreter error. PowerShell scripts prefer CRLF.
*.sh  text eol=lf
*.ps1 text eol=crlf

# Binary assets: never touch line endings, never try to diff as text.
*.png  binary
*.jpg  binary
*.gif  binary
*.mp4  binary
*.exr  binary
*.npy  binary
*.pyd  binary
