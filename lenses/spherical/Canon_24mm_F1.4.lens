  "metadata": {
    "name": "Canon EF 24mm f/1.4L USM — JP 1999-030743 Example 6",
    "description": "Spherical 24.6 mm f/1.45 patent prescription converted from Example 6. Includes the published flare stop, aperture stop, and surface-18 asphere.",
    "source": "JP 1999-030743, Example 6 (source title: Canon EF24mm f1.4L USM)",
    "focal_length_mm": 24.6,
    "nominal_f_number": 1.45,
    "angle_of_view_deg": 82.7,
    "source_image_height_mm": 43.28,
    "object_distance": "infinity",
    "paraxial_back_focus_mm": 36.467,
    "back_focus_mm": 37.59,
    "flare_stop_surface": 10,
    "aperture_stop_surface": 15,
    "aspheric_surface": 18,
    "coating_status": "not specified by the supplied prescription; surfaces are uncoated",
    "conversion_note": "The source FS at surface 10 is an active air interface whose clear aperture clips rays but is not tagged is_stop. The source AS at surface 15 is the sole pupil-defining aperture stop. Clear-aperture diameters were divided by two for semi_aperture."
  },
